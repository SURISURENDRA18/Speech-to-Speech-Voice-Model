# Model files. Relative paths are resolved from the repository root.
S2S_LLM_MODEL=models/llm/Qwen3.5-4B-UD-Q4_K_XL.gguf
S2S_TTS_TALKER=models/qwen3-tts/qwen-talker-1.7b-customvoice-Q8_0.gguf
S2S_TTS_CODEC=models/qwen3-tts/qwen-tokenizer-12hz-Q8_0.gguf
S2S_SMART_TURN_MODEL=models/smart-turn-v3/smart-turn-v3.2-cpu.onnx

# Inference settings.
S2S_STT_DEVICE=cuda
S2S_TTS_SPEAKER=aiden
S2S_LLM_GPU_LAYERS=99
S2S_LLM_CONTEXT_SIZE=8192

# Local service endpoints.
S2S_LLM_HOST=127.0.0.1
S2S_LLM_PORT=8080
S2S_PIPELINE_HOST=127.0.0.1
S2S_PIPELINE_PORT=8765
S2S_DEMO_HOST=127.0.0.1
S2S_DEMO_PORT=7860

# Indian languages: hear with Whisper and speak with Svara TTS.
# S2S_STT=whisper
# S2S_TTS=svara
# S2S_SVARA_MODEL=models/svara/svara-tts-v1.Q4_K_M.gguf
# S2S_SVARA_GENDER=female
# S2S_SVARA_LANGUAGE=hi
# S2S_SVARA_NORMALIZER_LANGUAGES=hi,en
# S2S_VOICES=Female,Male

# Public deployment behind an HTTPS proxy. See deploy/gcp/README.md.
# S2S_PUBLIC_URL=wss://voice.example.com/v1/realtime
# S2S_WEBRTC=0
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD_HASH=   (make one with: python demo/admin_auth.py hash-password)
# ADMIN_SESSION_SECRET=  (make one with: openssl rand -hex 32)
